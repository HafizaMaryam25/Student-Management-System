@model StudentManagementSystem.Models.StudentDetail

@{
    ViewData["Title"] = "Delete Student";

    var initial =
        string.IsNullOrEmpty(Model.FullName)
        ? "S"
        : Model.FullName.Substring(0, 1).ToUpper();
}

<div class="delete-page">

    <div class="container py-5">

        <div class="delete-wrapper animate-delete">

            <!-- WARNING ICON -->

            <div class="delete-warning">

                <div class="warning-ring"></div>

                <div class="warning-icon">
                    <i class="bi bi-trash3-fill"></i>
                </div>

            </div>


            <!-- TITLE -->

            <div class="delete-title">

                <div class="delete-eyebrow">
                    PROFILE ACTION
                </div>

                <h1>
                    Delete Student?
                </h1>

                <p>
                    This action will permanently remove the
                    student profile from the system.
                </p>

            </div>


            <!-- STUDENT CARD -->

            <div class="delete-student-profile">

                <div class="delete-avatar">
                    @initial
                </div>

                <div class="delete-student-info">

                    <strong>
                        @Model.FullName
                    </strong>

                    <span>
                        <i class="bi bi-envelope"></i>
                        @Model.Email
                    </span>

                </div>

                <div class="delete-status">
                    Student
                </div>

            </div>


            <!-- WARNING MESSAGE -->

            <div class="danger-info">

                <i class="bi bi-exclamation-triangle-fill"></i>

                <div>

                    <strong>
                        Are you sure?
                    </strong>

                    <span>
                        The student information cannot be recovered
                        after deletion.
                    </span>

                </div>

            </div>


            <!-- ACTIONS -->

            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="Id" />

                <div class="delete-actions">

                    <a asp-action="Index"
                       class="cancel-delete-btn">

                        <i class="bi bi-arrow-left"></i>

                        Cancel

                    </a>


                    <button type="submit"
                            class="confirm-delete-btn">

                        <i class="bi bi-trash3-fill"></i>

                        Delete Student

                    </button>

                </div>

            </form>


            <div class="delete-security">

                <i class="bi bi-shield-check"></i>

                Secure account management

            </div>

        </div>

    </div>

</div>


<style>

    .delete-page {
        min-height: 90vh;

        display: flex;
        align-items: center;

        background:
            radial-gradient(
                circle at 50% 20%,
                rgba(239,68,68,.06),
                transparent 30%
            ),
            radial-gradient(
                circle at 10% 70%,
                rgba(59,130,246,.07),
                transparent 30%
            );
    }

    .animate-delete {
        animation:
            deleteEnter .7s cubic-bezier(.2,.8,.2,1) both;
    }

    @@keyframes deleteEnter {

        from {
            opacity: 0;
            transform:
                translateY(25px)
                scale(.98);
        }

        to {
            opacity: 1;
            transform:
                translateY(0)
                scale(1);
        }

    }


    .delete-wrapper {
        position: relative;
        overflow: hidden;

        max-width: 650px;

        margin: auto;

        padding: 45px;

        text-align: center;

        border:
            1px solid rgba(255,255,255,.08);

        border-radius: 28px;

        background:
            linear-gradient(
                145deg,
                rgba(17,27,45,.94),
                rgba(8,15,29,.96)
            );

        box-shadow:
            0 40px 100px rgba(0,0,0,.35);
    }

    .delete-wrapper::before {
        content: "";

        position: absolute;

        width: 350px;
        height: 350px;

        left: 50%;
        top: -250px;

        transform: translateX(-50%);

        border-radius: 50%;

        background:
            rgba(239,68,68,.07);

        filter: blur(70px);

        pointer-events: none;
    }


    /* WARNING */

    .delete-warning {
        position: relative;

        width: 88px;
        height: 88px;

        margin: 0 auto 25px;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .warning-icon {
        position: relative;
        z-index: 2;

        width: 68px;
        height: 68px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 21px;

        color: #f87171;

        background:
            rgba(239,68,68,.10);

        border:
            1px solid rgba(239,68,68,.18);

        font-size: 1.45rem;

        animation:
            warningFloat 3.5s ease-in-out infinite;
    }

    @@keyframes warningFloat {

        0%,100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }

    }

    .warning-ring {
        position: absolute;

        inset: 0;

        border:
            1px solid rgba(248,113,113,.14);

        border-radius: 50%;

        animation:
            warningRing 3s ease-out infinite;
    }

    @@keyframes warningRing {

        0% {
            transform: scale(.75);
            opacity: .8;
        }

        100% {
            transform: scale(1.3);
            opacity: 0;
        }

    }


    /* TITLE */

    .delete-eyebrow {
        margin-bottom: 9px;

        color: #64748b;

        font-size: .58rem;

        font-weight: 850;

        letter-spacing: 1.5px;
    }

    .delete-title h1 {
        margin: 0;

        color: white;

        font-size:
            clamp(2.2rem,5vw,3.8rem);

        letter-spacing: -2px;

        font-weight: 850;
    }

    .delete-title h1 span {
        background:
            linear-gradient(
                100deg,
                #f87171,
                #fb7185
            );

        -webkit-background-clip: text;
        background-clip: text;

        color: transparent;
    }

    .delete-title p {
        max-width: 450px;

        margin: 15px auto 28px;

        color: #718096;

        font-size: .76rem;

        line-height: 1.8;
    }


    /* STUDENT */

    .delete-student-profile {
        display: flex;
        align-items: center;
        gap: 13px;

        padding: 17px;

        text-align: left;

        border:
            1px solid rgba(255,255,255,.07);

        border-radius: 17px;

        background:
            rgba(255,255,255,.025);
    }

    .delete-avatar {
        width: 48px;
        height: 48px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 14px;

        color: white;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #7c3aed
            );

        font-weight: 850;
    }

    .delete-student-info {
        flex: 1;
    }

    .delete-student-info strong {
        display: block;

        color: #f1f5f9;

        font-size: .78rem;
    }

    .delete-student-info span {
        display: block;

        margin-top: 4px;

        color: #64748b;

        font-size: .62rem;
    }

    .delete-student-info i {
        margin-right: 4px;
    }

    .delete-status {
        padding: 6px 9px;

        border-radius: 8px;

        color: #94a3b8;

        background:
            rgba(255,255,255,.04);

        font-size: .58rem;

        font-weight: 700;
    }


    /* DANGER */

    .danger-info {
        display: flex;
        align-items: center;
        gap: 11px;

        margin: 18px 0;

        padding: 15px;

        text-align: left;

        border:
            1px solid rgba(239,68,68,.12);

        border-radius: 14px;

        background:
            rgba(239,68,68,.045);
    }

    .danger-info > i {
        color: #f87171;
        font-size: 1rem;
    }

    .danger-info strong {
        display: block;

        color: #fca5a5;

        font-size: .65rem;
    }

    .danger-info span {
        display: block;

        margin-top: 3px;

        color: #6f7c8f;

        font-size: .59rem;
    }


    /* ACTIONS */

    .delete-actions {
        display: grid;

        grid-template-columns: 1fr 1fr;

        gap: 11px;

        margin-top: 24px;
    }

    .cancel-delete-btn,
    .confirm-delete-btn {
        min-height: 47px;

        display: flex;
        align-items: center;
        justify-content: center;

        gap: 8px;

        border-radius: 11px;

        font-size: .68rem;

        font-weight: 750;

        transition:
            transform .3s ease,
            box-shadow .3s ease,
            background .3s ease;
    }

    .cancel-delete-btn {
        color: #b8c5d6 !important;

        border:
            1px solid rgba(255,255,255,.10);

        background:
            rgba(255,255,255,.035);
    }

    .cancel-delete-btn:hover {
        color: white !important;

        transform: translateY(-3px);

        background:
            rgba(255,255,255,.07);
    }

    .confirm-delete-btn {
        border: none;

        color: white;

        background:
            linear-gradient(
                135deg,
                #dc2626,
                #ef4444
            );

        box-shadow:
            0 12px 30px rgba(239,68,68,.20);
    }

    .confirm-delete-btn:hover {
        transform: translateY(-4px);

        box-shadow:
            0 18px 40px rgba(239,68,68,.35);
    }


    /* SECURITY */

    .delete-security {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;

        margin-top: 20px;

        color: #4ade80;

        font-size: .58rem;

        font-weight: 650;
    }


    @@media(max-width:600px) {

        .delete-wrapper {
            padding: 30px 20px;
        }

        .delete-actions {
            grid-template-columns: 1fr;
        }

        .delete-student-profile {
            align-items: flex-start;
        }

        .delete-status {
            display: none;
        }

    }

</style>