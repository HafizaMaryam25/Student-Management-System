@model StudentManagementSystem.Models.StudentDetail

@{
    ViewData["Title"] = "Student Details";

    var initial =
        string.IsNullOrEmpty(Model.FullName)
        ? "S"
        : Model.FullName.Substring(0, 1).ToUpper();
}

<div class="profile-page">

    <div class="container py-5">

        <!-- TOP HEADER -->

        <div class="profile-page-header animate-profile">

            <div>

                <div class="profile-eyebrow">
                    <span class="status-dot"></span>
                    STUDENT PROFILE
                </div>

                <h1>
                    Student Details               
                     </h1>

                <p>
                    View complete student information
                    and manage the profile from one place.
                </p>

            </div>

            <a asp-action="Index"
               class="glass-back-btn">

                <i class="bi bi-arrow-left"></i>

                Back to Students

            </a>

        </div>


        <!-- PROFILE CARD -->

        <div class="premium-profile-card animate-profile delay-profile-1">

            <div class="profile-card-glow"></div>

            <!-- PROFILE TOP -->

            <div class="premium-profile-top">

                <div class="premium-avatar">

                    @initial

                </div>


                <div class="premium-profile-name">

                    <div class="small-profile-label">
                        STUDENT ACCOUNT
                    </div>

                    <h2>
                        @Model.FullName
                    </h2>

                    <div class="profile-status">
                        <span></span>
                        Active Profile
                    </div>

                </div>


                <div class="profile-top-action">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="premium-primary-btn">

                        <i class="bi bi-pencil-square"></i>

                        Edit Profile

                    </a>

                </div>

            </div>


            <!-- INFORMATION -->

            <div class="profile-section-title">

                <div class="profile-section-icon">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>

                <div>

                    <span>
                        PERSONAL INFORMATION
                    </span>

                    <h3>
                        Student Information
                    </h3>

                </div>

            </div>


            <div class="premium-profile-grid">

                <div class="premium-profile-item">

                    <div class="profile-item-icon blue">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div>
                        <span>FULL NAME</span>
                        <strong>@Model.FullName</strong>
                    </div>

                </div>


                <div class="premium-profile-item">

                    <div class="profile-item-icon purple">
                        <i class="bi bi-envelope-fill"></i>
                    </div>

                    <div>
                        <span>EMAIL ADDRESS</span>
                        <strong>@Model.Email</strong>
                    </div>

                </div>


                <div class="premium-profile-item">

                    <div class="profile-item-icon cyan">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>

                    <div>
                        <span>FATHER'S NAME</span>
                        <strong>@Model.FatherName</strong>
                    </div>

                </div>


                <div class="premium-profile-item">

                    <div class="profile-item-icon green">
                        <i class="bi bi-telephone-fill"></i>
                    </div>

                    <div>
                        <span>CONTACT NUMBER</span>
                        <strong>@Model.Contact</strong>
                    </div>

                </div>


                <div class="premium-profile-item">

                    <div class="profile-item-icon orange">
                        <i class="bi bi-calendar-event-fill"></i>
                    </div>

                    <div>
                        <span>AGE</span>
                        <strong>@Model.Age years</strong>
                    </div>

                </div>


                <div class="premium-profile-item">

                    <div class="profile-item-icon pink">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <div>
                        <span>ADDRESS</span>
                        <strong>@Model.Address</strong>
                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="profile-card-footer">

                <div class="profile-secure">

                    <i class="bi bi-shield-check"></i>

                    <div>

                        <strong>
                            Secure Student Record
                        </strong>

                        <span>
                            Protected student information
                            stored in the cloud system.
                        </span>

                    </div>

                </div>


                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="profile-delete-link">

                    <i class="bi bi-trash3"></i>

                    Delete Profile

                </a>

            </div>

        </div>

    </div>

</div>


<style>

    .profile-page {
        min-height: 90vh;

        background:
            radial-gradient(
                circle at 10% 5%,
                rgba(59,130,246,.09),
                transparent 28%
            ),
            radial-gradient(
                circle at 90% 30%,
                rgba(139,92,246,.08),
                transparent 28%
            );
    }

    .animate-profile {
        animation:
            profileEnter .7s cubic-bezier(.2,.8,.2,1) both;
    }

    .delay-profile-1 {
        animation-delay: .15s;
    }

    @@keyframes profileEnter {

        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

    }

    .profile-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 30px;
        margin-bottom: 35px;
    }

    .profile-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 15px;

        color: #8db8ff;
        font-size: .64rem;
        font-weight: 850;
        letter-spacing: 1.6px;
    }

    .profile-page-header h1 {
        margin: 0;
        color: white;
        font-size: clamp(2.6rem,5vw,4.7rem);
        line-height: .98;
        letter-spacing: -3px;
        font-weight: 850;
    }

    .profile-page-header h1 span {
        display: block;

        background:
            linear-gradient(
                100deg,
                #70a9ff,
                #22d3ee 45%,
                #a78bfa
            );

        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .profile-page-header p {
        max-width: 550px;
        margin: 18px 0 0;
        color: #77869b;
        line-height: 1.8;
        font-size: .82rem;
    }

    .glass-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;

        padding: 11px 16px;

        border:
            1px solid rgba(255,255,255,.10);

        border-radius: 11px;

        color: #b8c5d6 !important;

        background:
            rgba(255,255,255,.035);

        transition: all .3s ease;
    }

    .glass-back-btn:hover {
        color: white !important;
        transform: translateY(-3px);
        background: rgba(255,255,255,.07);
    }


    /* PROFILE CARD */

    .premium-profile-card {
        position: relative;
        overflow: hidden;

        padding: 35px;

        border:
            1px solid rgba(255,255,255,.08);

        border-radius: 27px;

        background:
            linear-gradient(
                145deg,
                rgba(14,27,49,.91),
                rgba(7,15,29,.93)
            );

        box-shadow:
            0 35px 90px rgba(0,0,0,.30);
    }

    .profile-card-glow {
        position: absolute;

        width: 350px;
        height: 350px;

        right: -150px;
        top: -180px;

        border-radius: 50%;

        background:
            rgba(59,130,246,.10);

        filter: blur(80px);

        pointer-events: none;
    }


    /* PROFILE TOP */

    .premium-profile-top {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: center;
        gap: 20px;

        padding-bottom: 30px;

        border-bottom:
            1px solid rgba(255,255,255,.07);
    }

    .premium-avatar {
        width: 82px;
        height: 82px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 25px;

        color: white;

        background:
            linear-gradient(
                135deg,
                #2563eb,
                #7c3aed
            );

        font-size: 1.7rem;
        font-weight: 850;

        box-shadow:
            0 18px 40px rgba(37,99,235,.28);

        animation:
            avatarFloat 5s ease-in-out infinite;
    }

    @@keyframes avatarFloat {

        0%,100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }

    }

    .premium-profile-name {
        flex: 1;
    }

    .small-profile-label {
        color: #607087;
        font-size: .57rem;
        font-weight: 850;
        letter-spacing: 1.4px;
    }

    .premium-profile-name h2 {
        margin: 5px 0 7px;
        color: white;
        font-size: 1.45rem;
        font-weight: 800;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        color: #86efac;
        font-size: .65rem;
        font-weight: 700;
    }

    .profile-status span {
        width: 6px;
        height: 6px;

        border-radius: 50%;

        background: #22c55e;

        box-shadow:
            0 0 10px rgba(34,197,94,.8);
    }


    /* SECTION */

    .profile-section-title {
        display: flex;
        align-items: center;
        gap: 13px;

        margin: 32px 0 20px;
    }

    .profile-section-icon {
        width: 43px;
        height: 43px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 12px;

        color: #60a5fa;
        background: rgba(59,130,246,.12);
    }

    .profile-section-title span {
        color: #607087;
        font-size: .57rem;
        font-weight: 850;
        letter-spacing: 1.3px;
    }

    .profile-section-title h3 {
        margin: 3px 0 0;
        color: white;
        font-size: .98rem;
        font-weight: 750;
    }


    /* GRID */

    .premium-profile-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 14px;
    }

    .premium-profile-item {
        display: flex;
        align-items: center;
        gap: 14px;

        padding: 19px;

        border:
            1px solid rgba(255,255,255,.055);

        border-radius: 16px;

        background:
            rgba(255,255,255,.025);

        transition:
            transform .3s ease,
            border-color .3s ease,
            background .3s ease;
    }

    .premium-profile-item:hover {
        transform: translateY(-4px);
        border-color: rgba(96,165,250,.18);
        background: rgba(255,255,255,.045);
    }

    .profile-item-icon {
        width: 42px;
        height: 42px;

        display: flex;
        align-items: center;
        justify-content: center;

        flex-shrink: 0;

        border-radius: 12px;
    }

    .profile-item-icon.blue {
        color: #60a5fa;
        background: rgba(59,130,246,.12);
    }

    .profile-item-icon.purple {
        color: #a78bfa;
        background: rgba(139,92,246,.12);
    }

    .profile-item-icon.cyan {
        color: #22d3ee;
        background: rgba(34,211,238,.12);
    }

    .profile-item-icon.green {
        color: #4ade80;
        background: rgba(34,197,94,.12);
    }

    .profile-item-icon.orange {
        color: #fbbf24;
        background: rgba(245,158,11,.12);
    }

    .profile-item-icon.pink {
        color: #f472b6;
        background: rgba(236,72,153,.12);
    }

    .premium-profile-item span {
        display: block;
        color: #5f6e82;
        font-size: .56rem;
        font-weight: 850;
        letter-spacing: .8px;
    }

    .premium-profile-item strong {
        display: block;
        margin-top: 5px;
        color: #e2e8f0;
        font-size: .76rem;
        word-break: break-word;
    }


    /* FOOTER */

    .profile-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;

        margin-top: 28px;
        padding-top: 22px;

        border-top:
            1px solid rgba(255,255,255,.06);
    }

    .profile-secure {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .profile-secure > i {
        color: #4ade80;
        font-size: 1.05rem;
    }

    .profile-secure strong {
        display: block;
        color: #cbd5e1;
        font-size: .67rem;
    }

    .profile-secure span {
        display: block;
        margin-top: 3px;
        color: #56657a;
        font-size: .59rem;
    }

    .profile-delete-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        color: #f87171 !important;
        font-size: .67rem;
        font-weight: 700;

        transition: all .25s ease;
    }

    .profile-delete-link:hover {
        transform: translateY(-2px);
        color: #fca5a5 !important;
    }


    @@media(max-width:768px) {

        .profile-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .premium-profile-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .premium-profile-grid {
            grid-template-columns: 1fr;
        }

        .profile-card-footer {
            align-items: flex-start;
            flex-direction: column;
        }

    }

</style>