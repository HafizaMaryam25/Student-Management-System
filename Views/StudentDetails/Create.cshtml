@model StudentManagementSystem.Models.StudentDetail

@{
    ViewData["Title"] = "Create Student Profile";
}

<div class="form-page-wrapper py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="modern-glass-form-card p-4 p-md-5">
                    
                    <!-- Form Header -->
                    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom border-dark-subtle">
                        <div class="feature-icon-badge cyan mb-0">
                            <i class="bi bi-person-plus-fill fs-3"></i>
                        </div>
                        <div>
                            <h2 class="text-white fw-bold mb-1">Create Student Profile</h2>
                            <p class="text-secondary mb-0">Enter student details to add a new record into the cloud system</p>
                        </div>
                    </div>

                    <form asp-action="Create" class="mt-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger-custom mb-4" role="alert"></div>

                        <div class="row g-4">
                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label-custom">
                                    <i class="bi bi-person me-1 text-cyan"></i> Full Name
                                </label>
                                <div class="input-group-custom">
                                    <input asp-for="FullName" class="form-control glass-input" placeholder="e.g. John Doe" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger-custom fs-7 mt-1 d-block"></span>
                            </div>

                            <!-- Email Address -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label-custom">
                                    <i class="bi bi-envelope me-1 text-cyan"></i> Email Address
                                </label>
                                <div class="input-group-custom">
                                    <input asp-for="Email" class="form-control glass-input readonly-input" readonly />
                                </div>
                            </div>

                            <!-- Father's Name -->
                            <div class="col-md-6">
                                <label asp-for="FatherName" class="form-label-custom">
                                    <i class="bi bi-person-gear me-1 text-cyan"></i> Father's Name
                                </label>
                                <div class="input-group-custom">
                                    <input asp-for="FatherName" class="form-control glass-input" placeholder="e.g. Robert Doe" />
                                </div>
                                <span asp-validation-for="FatherName" class="text-danger-custom fs-7 mt-1 d-block"></span>
                            </div>

                            <!-- Contact Number -->
                            <div class="col-md-6">
                                <label asp-for="Contact" class="form-label-custom">
                                    <i class="bi bi-telephone me-1 text-cyan"></i> Contact Number
                                </label>
                                <div class="input-group-custom">
                                    <input asp-for="Contact" class="form-control glass-input" placeholder="03XX XXXXXXX" />
                                </div>
                                <span asp-validation-for="Contact" class="text-danger-custom fs-7 mt-1 d-block"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-md-8">
                                <label asp-for="Address" class="form-label-custom">
                                    <i class="bi bi-geo-alt me-1 text-cyan"></i> Address
                                </label>
                                <div class="input-group-custom">
                                    <input asp-for="Address" class="form-control glass-input" placeholder="Street, City, Country" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger-custom fs-7 mt-1 d-block"></span>
                            </div>

                            <!-- Age -->
                            <div class="col-md-4">
                                <label asp-for="Age" class="form-label-custom">
                                    <i class="bi bi-calendar-event me-1 text-cyan"></i> Age
                                </label>
                                <div class="input-group-custom">
                                    <input asp-for="Age" class="form-control glass-input" type="number" placeholder="Age" />
                                </div>
                                <span asp-validation-for="Age" class="text-danger-custom fs-7 mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Form Footer Actions -->
                        <div class="d-flex justify-content-end align-items-center gap-3 mt-5 pt-3 border-top border-dark-subtle">
                            <a asp-controller="Home" asp-action="Index" class="btn glass-outline-btn">
                                Cancel
                            </a>
                            <button type="submit" class="btn glow-primary-btn px-4">
                                <i class="bi bi-check-circle-fill me-2"></i> Create Profile
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-page-wrapper {
        min-height: 90vh;
        background: radial-gradient(circle at 10% 10%, rgba(34, 211, 238, 0.08), transparent 30%),
                    radial-gradient(circle at 90% 80%, rgba(139, 92, 246, 0.08), transparent 30%);
    }

    .modern-glass-form-card {
        background: linear-gradient(145deg, rgba(14, 27, 49, 0.92), rgba(7, 15, 29, 0.95));
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(16px);
    }

    .feature-icon-badge.cyan {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: rgba(34, 211, 238, 0.12);
        color: #22d3ee;
        border: 1px solid rgba(34, 211, 238, 0.2);
    }

    .text-cyan {
        color: #22d3ee !important;
    }

    .form-label-custom {
        display: block;
        color: #cbd5e1;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 8px;
        letter-spacing: 0.3px;
    }

    .glass-input {
        background: rgba(15, 23, 42, 0.6) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        border-radius: 12px !important;
        color: #f8fafc !important;
        padding: 12px 16px !important;
        font-size: 0.9rem !important;
        transition: all 0.25s ease !important;
    }

    .glass-input:focus {
        border-color: #22d3ee !important;
        box-shadow: 0 0 15px rgba(34, 211, 238, 0.25) !important;
        background: rgba(15, 23, 42, 0.8) !important;
    }

    .glass-input::placeholder {
        color: #475569;
    }

    .readonly-input {
        background: rgba(30, 41, 59, 0.4) !important;
        color: #94a3b8 !important;
        border-style: dashed !important;
        cursor: not-allowed;
    }

    .glow-primary-btn {
        background: linear-gradient(135deg, #0284c7, #2563eb);
        border: none;
        color: #ffffff;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 12px;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(2, 132, 199, 0.3);
    }

    .glow-primary-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(2, 132, 199, 0.45);
        color: #ffffff;
    }

    .glass-outline-btn {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        color: #94a3b8;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .glass-outline-btn:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.3);
        color: #f1f5f9;
    }

    .text-danger-custom {
        color: #f87171;
        font-size: 0.8rem;
    }

    .alert-danger-custom {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #fca5a5;
        border-radius: 12px;
    }
</style>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}