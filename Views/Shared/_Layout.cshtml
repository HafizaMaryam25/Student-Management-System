<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Student Management System
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body>

<header>

    <nav class="navbar navbar-expand-lg main-navbar">

        <div class="container">

            <!-- BRAND -->

            <a class="navbar-brand-modern"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">

                <div class="brand-icon">

                    <i class="bi bi-mortarboard-fill"></i>

                </div>

                <div class="brand-text">

                    <small>SMART CAMPUS</small>

                    <strong>
                        Student Management
                    </strong>

                </div>

            </a>


            <!-- MOBILE -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <i class="bi bi-list text-white"></i>

            </button>


            <div class="collapse navbar-collapse"
                 id="mainNavbar">

                <!-- LINKS -->

                <ul class="navbar-nav nav-modern-links mx-auto">

                    <li class="nav-item">

                        <a class="nav-link active"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house-door me-1"></i>

                            Home

                        </a>

                    </li>


                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="StudentDetails"
                               asp-action="Index">

                                <i class="bi bi-grid-1x2 me-1"></i>

                                Dashboard

                            </a>

                        </li>


                        @if (User.IsInRole("Admin"))
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="StudentDetails"
                                   asp-action="Index">

                                    <i class="bi bi-people me-1"></i>

                                    Students

                                </a>

                            </li>

                        }
                        else
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="StudentDetails"
                                   asp-action="MyProfile">

                                    <i class="bi bi-person me-1"></i>

                                    My Profile

                                </a>

                            </li>

                        }

                    }


                    <li class="nav-item">

                        <a class="nav-link"
                           href="#features">

                            <i class="bi bi-stars me-1"></i>

                            Features

                        </a>

                    </li>

                </ul>


                <!-- RIGHT SIDE -->

                <div class="d-flex align-items-center gap-2">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <div class="nav-user-pill">

                            <div class="nav-user-icon">

                                <i class="bi bi-person-fill"></i>

                            </div>

                            <span>

                                @User.Identity.Name

                            </span>

                        </div>


                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="nav-login-btn">

                                <i class="bi bi-box-arrow-right"></i>

                                Logout

                            </button>

                        </form>

                    }
                    else
                    {

                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="nav-login-btn">

                            <i class="bi bi-box-arrow-in-right"></i>

                            Login

                        </a>

                    }

                </div>

            </div>

        </div>

    </nav>

</header>


<main>

    @RenderBody()

</main>


<!-- =====================================================
     MODERN FOOTER
     ===================================================== -->

<footer class="modern-footer">

    <div class="container">

        <div class="row g-5">


            <!-- BRAND -->

            <div class="col-lg-5 col-md-6">

                <div class="footer-brand">

                    <div class="footer-brand-icon">

                        <i class="bi bi-mortarboard-fill"></i>

                    </div>

                    <div>

                        <strong>
                            Student Management
                        </strong>

                        <small>
                            SMART CAMPUS PLATFORM
                        </small>

                    </div>

                </div>


                <p class="footer-description">

                    A modern student management platform designed
                    to make student records, profiles and
                    administration simpler, faster and more
                    organized.

                </p>


                <div class="footer-socials">

                    <a href="#"
                       class="footer-social"
                       aria-label="GitHub">

                        <i class="bi bi-github"></i>

                    </a>

                    <a href="#"
                       class="footer-social"
                       aria-label="LinkedIn">

                        <i class="bi bi-linkedin"></i>

                    </a>

                    <a href="#"
                       class="footer-social"
                       aria-label="Email">

                        <i class="bi bi-envelope"></i>

                    </a>

                </div>

            </div>


            <!-- PLATFORM -->

            <div class="col-lg-2 col-md-6">

                <h5 class="footer-heading">
                    Platform
                </h5>

                <ul class="footer-links">

                    <li>
                        <a href="#features">
                            Features
                        </a>
                    </li>

                    <li>
                        <a href="#features">
                            Student Management
                        </a>
                    </li>

                    <li>
                        <a href="#features">
                            Cloud Database
                        </a>
                    </li>

                    <li>
                        <a href="#features">
                            Security
                        </a>
                    </li>

                </ul>

            </div>


            <!-- ACCOUNT -->

            <div class="col-lg-2 col-md-6">

                <h5 class="footer-heading">
                    Account
                </h5>

                <ul class="footer-links">

                    @if (User.Identity?.IsAuthenticated == true)
                    {

                        <li>

                            <a asp-controller="StudentDetails"
                               asp-action="Index">

                                Dashboard

                            </a>

                        </li>

                        <li>

                            <a asp-controller="StudentDetails"
                               asp-action="MyProfile">

                                My Profile

                            </a>

                        </li>

                    }
                    else
                    {

                        <li>

                            <a asp-area="Identity"
                               asp-page="/Account/Login">

                                Login

                            </a>

                        </li>

                        <li>

                            <a asp-area="Identity"
                               asp-page="/Account/Register">

                                Create Account

                            </a>

                        </li>

                    }

                </ul>

            </div>


            <!-- TECHNOLOGY -->

            <div class="col-lg-3 col-md-6">

                <h5 class="footer-heading">
                    Technology
                </h5>

                <ul class="footer-links">

                    <li>
                        <a href="#features">
                            Firebase Cloud
                        </a>
                    </li>

                    <li>
                        <a href="#features">
                            Secure Authentication
                        </a>
                    </li>

                    <li>
                        <a href="#features">
                            Responsive UI
                        </a>
                    </li>

                    <li>
                        <a href="#features">
                            Modern Web
                        </a>
                    </li>

                </ul>

            </div>

        </div>


        <!-- FOOTER BOTTOM -->

        <div class="footer-bottom">

            <p>
                © @DateTime.Now.Year Student Management System.
                All rights reserved.
            </p>


            <div class="footer-status">

                <span></span>

                System Operational

            </div>

        </div>

    </div>

</footer>


<!-- SCRIPTS -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>


<script>

    /* =====================================================
       NAVBAR SCROLL EFFECT
       ===================================================== */

    window.addEventListener("scroll", function () {

        const navbar =
            document.querySelector(".main-navbar");

        if (!navbar)
            return;

        if (window.scrollY > 25) {

            navbar.classList.add("scrolled");

        } else {

            navbar.classList.remove("scrolled");

        }

    });


    /* =====================================================
       SCROLL REVEAL ANIMATION
       ===================================================== */

    const revealElements =
        document.querySelectorAll(
            ".reveal, .reveal-left, .reveal-right"
        );


    const revealObserver =
        new IntersectionObserver(
            function (entries) {

                entries.forEach(function (entry) {

                    if (entry.isIntersecting) {

                        entry.target.classList.add("visible");

                        revealObserver.unobserve(
                            entry.target
                        );

                    }

                });

            },
            {
                threshold: 0.12
            }
        );


    revealElements.forEach(function (element) {

        revealObserver.observe(element);

    });


    /* =====================================================
       AUTO ADD REVEAL TO SECTIONS
       ===================================================== */

    document
        .querySelectorAll(
            ".intro-large-card, .side-info-card, .feature-premium-card, .technology-card, .final-cta"
        )
        .forEach(function (element, index) {

            element.classList.add("reveal");

            element.style.transitionDelay =
                (index * 0.06) + "s";

            revealObserver.observe(element);

        });


    /* =====================================================
       SMOOTH FEATURE LINK
       ===================================================== */

    document
        .querySelectorAll('a[href^="#"]')
        .forEach(function (link) {

            link.addEventListener(
                "click",
                function (event) {

                    const targetId =
                        this.getAttribute("href");

                    if (
                        targetId === "#" ||
                        targetId === ""
                    ) {
                        return;
                    }

                    const target =
                        document.querySelector(targetId);

                    if (target) {

                        event.preventDefault();

                        target.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });

                    }

                }
            );

        });

</script>


@await RenderSectionAsync(
    "Scripts",
    required: false
)

</body>

</html>