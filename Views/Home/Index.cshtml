                    </div>

                </div>

            </div>


            <!-- CARD 4 -->
            <div class="col-md-6 col-lg-4">

                <div class="feature-premium-card">

                    <div class="feature-top">

                        <div class="feature-icon orange">
                            <i class="bi bi-pencil-square"></i>
                        </div>

                        <span class="feature-number">
                            04
                        </span>

                    </div>

                    <h3>
                        Easy Editing
                    </h3>

                    <p>
                        Update student information quickly using
                        a simple and intuitive profile interface.
                    </p>

                    <div class="feature-link">
                        Easy Updates
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

            </div>


            <!-- CARD 5 -->
            <div class="col-md-6 col-lg-4">

                <div class="feature-premium-card">

                    <div class="feature-top">

                        <div class="feature-icon pink">
                            <i class="bi bi-speedometer2"></i>
                        </div>

                        <span class="feature-number">
                            05
                        </span>

                    </div>

                    <h3>
                        Fast Experience
                    </h3>

                    <p>
                        Lightweight interfaces make everyday
                        student management smooth and efficient.
                    </p>

                    <div class="feature-link">
                        Smooth Workflow
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

            </div>


            <!-- CARD 6 -->
            <div class="col-md-6 col-lg-4">

                <div class="feature-premium-card">

                    <div class="feature-top">

                        <div class="feature-icon cyan">
                            <i class="bi bi-phone-fill"></i>
                        </div>

                        <span class="feature-number">
                            06
                        </span>

                    </div>

                    <h3>
                        Responsive Design
                    </h3>

                    <p>
                        A responsive experience designed to work
                        beautifully across desktop, tablet and mobile.
                    </p>

                    <div class="feature-link">
                        Every Device
                        <i class="bi bi-arrow-up-right"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     SECURITY / CLOUD SECTION
========================================================= -->

<section class="technology-section">

    <div class="container">

        <div class="technology-card">

            <div class="technology-content">

                <div class="section-eyebrow light">
                    <span></span>
                    MODERN TECHNOLOGY
                </div>

                <h2>
                    Designed for a
                    <span>connected campus.</span>
                </h2>

                <p>
                    Your student management experience is supported
                    by modern web technologies and cloud infrastructure.
                </p>

                <div class="technology-points">

                    <div class="technology-point">

                        <div class="technology-point-icon">
                            <i class="bi bi-cloud-check-fill"></i>
                        </div>

                        <div>
                            <strong>
                                Firebase Cloud
                            </strong>

                            <span>
                                Reliable cloud-based data storage
                            </span>
                        </div>

                    </div>


                    <div class="technology-point">

                        <div class="technology-point-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>

                        <div>
                            <strong>
                                Secure Authentication
                            </strong>

                            <span>
                                Controlled access for users
                            </span>
                        </div>

                    </div>


                    <div class="technology-point">

                        <div class="technology-point-icon">
                            <i class="bi bi-window-stack"></i>
                        </div>

                        <div>
                            <strong>
                                Modern Web Interface
                            </strong>

                            <span>
                                Clean and responsive user experience
                            </span>
                        </div>

                    </div>

                </div>

            </div>


            <div class="technology-visual">

                <div class="tech-circle circle-one"></div>
                <div class="tech-circle circle-two"></div>

                <div class="tech-main-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div class="tech-floating-card cloud">
                    <i class="bi bi-cloud-fill"></i>
                    Firebase
                </div>

                <div class="tech-floating-card security">
                    <i class="bi bi-shield-fill-check"></i>
                    Secure
                </div>

                <div class="tech-floating-card users">
                    <i class="bi bi-people-fill"></i>
                    Students
                </div>

            </div>

        </div>

    </div>

</section>



<!-- =========================================================
     FINAL CTA
========================================================= -->

<section class="final-cta-section">

    <div class="container">

        <div class="final-cta">

            <div class="cta-glow"></div>

            <div class="cta-content">

                <div class="cta-icon">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>

                <div>

                    <span>
                        STUDENT MANAGEMENT PLATFORM
                    </span>

                    <h2>
                        Ready to manage students smarter?
                    </h2>

                    <p>
                        Experience a clean, secure and modern
                        student management system.
                    </p>

                </div>

            </div>


            <div class="cta-action">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="StudentDetails"
                       asp-action="Index"
                       class="cta-button">

                        Open Dashboard
                        <i class="bi bi-arrow-right"></i>

                    </a>
                }
                else
                {
                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="cta-button">

                        Create Account
                        <i class="bi bi-arrow-right"></i>

                    </a>
                }

            </div>

        </div>

    </div>

</section>