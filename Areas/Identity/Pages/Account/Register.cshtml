@page
@model StudentManagementSystem.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="container py-5 d-flex justify-content-center">
        <div class="auth-wrapper animate-auth">
            
            <!-- HEADER -->
            <div class="profile-page-header text-center flex-column align-items-center mb-4">
                <div class="profile-eyebrow justify-content-center">
                    <span class="status-dot"></span>
                    JOIN US TODAY
                </div>
                <h1>
                    Create Your Account
                </h1>
                <p class="text-center">
                    Register a new student account to access your portal.
                </p>
            </div>

            <!-- REGISTER CARD -->
            <div class="premium-profile-card animate-auth delay-auth-1">
                <div class="profile-card-glow"></div>

                <div class="profile-section-title mt-0 mb-4">
                    <div class="profile-section-icon">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                        <span>REGISTRATION</span>
                        <h3>Sign Up for New Account</h3>
                    </div>
                </div>

                <form id="registerForm" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="auth-label"><i class="bi bi-envelope-fill me-1"></i> EMAIL ADDRESS</label>
                        <input asp-for="Input.Email" class="auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="auth-label"><i class="bi bi-lock-fill me-1"></i> PASSWORD</label>
                        <input asp-for="Input.Password" class="auth-input" type="password" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="auth-label"><i class="bi bi-shield-lock-fill me-1"></i> CONFIRM PASSWORD</label>
                        <input asp-for="Input.ConfirmPassword" class="auth-input" type="password" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="premium-primary-btn w-100 justify-content-center py-3">
                        <i class="bi bi-person-plus me-2"></i> Register Account
                    </button>
                </form>

                <!-- FOOTER / REDIRECT -->
                <div class="profile-card-footer flex-column align-items-center gap-2 mt-4 pt-3">
                    <div class="profile-secure text-center">
                        <i class="bi bi-shield-check me-1"></i>
                        <span>Protected Cloud System</span>
                    </div>
                    <div class="mt-2 text-center">
                        <span style="color: #607087; font-size: 0.8rem;">Already have an account?</span>
                        <a asp-page="./Login" class="auth-link ms-1">Login</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .auth-page {
        min-height: 90vh;
        background:
            radial-gradient(
                circle at 10% 5%,
                rgba(59,130,246,.09),
                transparent 28%
            ),
            radial-gradient(
                circle at 90% 30%,
                rgba(139,92,246,.08),
                transparent 28%
            );
    }

    .auth-wrapper {
        width: 100%;
        max-width: 480px;
    }

    .animate-auth {
        animation: authEnter .7s cubic-bezier(.2,.8,.2,1) both;
    }

    .delay-auth-1 {
        animation-delay: .15s;
    }

    @@keyframes authEnter {
        from {
            opacity: 0;
            transform: translateY(25px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .profile-page-header h1 {
        margin: 0;
        color: white;
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        line-height: .98;
        letter-spacing: -2px;
        font-weight: 850;
    }

    .profile-page-header h1 span {
        display: block;
        background: linear-gradient(100deg, #70a9ff, #22d3ee 45%, #a78bfa);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .profile-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 15px;
        color: #8db8ff;
        font-size: .64rem;
        font-weight: 850;
        letter-spacing: 1.6px;
    }

    .profile-page-header p {
        max-width: 550px;
        margin: 14px 0 0;
        color: #77869b;
        line-height: 1.6;
        font-size: .82rem;
    }

    .premium-profile-card {
        position: relative;
        overflow: hidden;
        padding: 35px;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 27px;
        background: linear-gradient(145deg, rgba(14,27,49,.91), rgba(7,15,29,.93));
        box-shadow: 0 35px 90px rgba(0,0,0,.30);
    }

    .profile-card-glow {
        position: absolute;
        width: 350px;
        height: 350px;
        right: -150px;
        top: -180px;
        border-radius: 50%;
        background: rgba(59,130,246,.10);
        filter: blur(80px);
        pointer-events: none;
    }

    .profile-section-title {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .profile-section-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #60a5fa;
        background: rgba(59,130,246,.12);
        font-size: 1.2rem;
    }

    .profile-section-title span {
        color: #607087;
        font-size: .57rem;
        font-weight: 850;
        letter-spacing: 1.3px;
    }

    .profile-section-title h3 {
        margin: 3px 0 0;
        color: white;
        font-size: .98rem;
        font-weight: 750;
    }

    .auth-label {
        display: block;
        color: #5f6e82;
        font-size: .62rem;
        font-weight: 850;
        letter-spacing: .8px;
        margin-bottom: 7px;
    }

    .auth-input {
        width: 100%;
        padding: 13px 16px;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,.08);
        background: rgba(255,255,255,.03);
        color: white;
        font-size: .85rem;
        outline: none;
        transition: all .3s ease;
    }

    .auth-input:focus {
        border-color: rgba(96,165,250,.5);
        background: rgba(255,255,255,.06);
        box-shadow: 0 0 15px rgba(59,130,246,.15);
    }

    .auth-input::placeholder {
        color: #475569;
    }

    .premium-primary-btn {
        display: inline-flex;
        align-items: center;
        padding: 12px 20px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: white !important;
        font-weight: 700;
        font-size: .85rem;
        cursor: pointer;
        transition: all .3s ease;
        box-shadow: 0 10px 25px rgba(37,99,235,.25);
    }

    .premium-primary-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(37,99,235,.35);
        opacity: 0.95;
    }

    .auth-link {
        color: #60a5fa !important;
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s ease;
    }

    .auth-link:hover {
        color: #93c5fd !important;
        text-decoration: underline;
    }

    .profile-card-footer {
        border-top: 1px solid rgba(255,255,255,.06);
    }

    .profile-secure {
        color: #cbd5e1;
        font-size: .67rem;
    }

    .profile-secure i {
        color: #4ade80;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}